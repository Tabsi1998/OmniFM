# Build-context allowlist. Runtime data, secrets, local backups, tests, and the
# archived Python reference must never be sent to a Docker builder.
*
!Dockerfile
!.dockerignore
!package.json
!package-lock.json
!docker-entrypoint.sh
!stations.json
!frontend/
!frontend/**
!src/
!src/**
!data/
!data/**
!web/
!web/**

# The frontend is rebuilt in the builder stage; do not transfer a stale local
# artifact even though the frontend source itself is allowlisted above.
frontend/node_modules
frontend/build
