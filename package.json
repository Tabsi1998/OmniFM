{
  "name": "omnifm",
  "version": "3.19.0",
  "private": true,
  "type": "module",
  "description": "OmniFM - 24/7 Discord Radio Streaming mit Premium Tier-System",
  "main": "src/index.js",
  "engines": {
    "node": ">=22.23.4 <23"
  },
  "scripts": {
    "start": "node src/index.js",
    "start:commander": "node src/entrypoints/commander.js",
    "start:worker": "node src/entrypoints/worker.js",
    "frontend:start": "npm --prefix frontend start",
    "frontend:build": "npm --prefix frontend run build",
    "deploy": "node src/deploy-commands.js",
    "stations": "node src/stations-cli.js",
    "stations:wizard": "node src/stations-cli.js wizard",
    "premium": "node src/premium-cli.js",
    "premium:wizard": "node src/premium-cli.js wizard",
    "release:preflight": "node scripts/release-gate.mjs --preflight",
    "release:postdeploy": "node scripts/release-gate.mjs --post-deploy",
    "release:rollback-plan": "node scripts/release-gate.mjs --rollback-plan",
    "seo:search-console": "node scripts/check-search-console-readiness.mjs",
    "test": "npm run test:repo-hygiene && npm run test:split-syntax && npm run test:syntax && npm run test:voice-codec && npm run test:unit",
    "test:repo-hygiene": "node scripts/check-repo-hygiene.mjs && node scripts/check-search-console-readiness.mjs && node scripts/check-api-routes.mjs",
    "test:split-syntax": "node --check src/entrypoints/from-owner-config.mjs && node --check src/entrypoints/split-supervisor.js && node --check src/entrypoints/api.js",
    "test:syntax": "node scripts/check-syntax.mjs",
    "lint": "node scripts/check-lint.mjs",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc -p tsconfig.json",
    "test:voice-codec": "node scripts/check-voice-codec.mjs",
    "test:unit": "node scripts/run-unit-tests.mjs"
  },
  "dependencies": {
    "@discordjs/opus": "^0.11.0",
    "@discordjs/rest": "^2.6.3",
    "@discordjs/voice": "^0.19.2",
    "@napi-rs/canvas": "^1.1.0",
    "@snazzah/davey": "^0.2.0",
    "discord.js": "^14.28.1",
    "dotenv": "^18.0.9",
    "ipaddr.js": "^2.5.0",
    "mongodb": "^7.8.0",
    "nodemailer": "^10.3.1",
    "sodium-native": "^5.2.0"
  },
  "overrides": {
    "@discordjs/node-pre-gyp": {
      "tar": "7.5.22"
    },
    "minimatch@^10": "^11.0.1",
    "lighthouse": {
      "@sentry/node": "^10.78.0"
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "axe-core": "4.14.0",
    "eslint": "^10.14.0",
    "eslint-plugin-n": "^18.5.0",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "lighthouse": "13.6.0",
    "playwright": "1.65.0",
    "typescript": "^7.0.2"
  }
}
