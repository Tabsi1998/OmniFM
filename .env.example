# Required bot runtime
BOT_1_TOKEN=your_discord_bot_token
BOT_1_CLIENT_ID=your_discord_application_id
BOT_1_NAME=OmniFM Commander
BOT_1_TIER=free

# Additional bots follow the same pattern:
# BOT_2_TOKEN=
# BOT_2_CLIENT_ID=
# BOT_2_NAME=OmniFM Worker 2
# BOT_2_TIER=free

# Topology and command registration
COMMANDER_BOT_INDEX=1
OMNIFM_DEPLOYMENT_MODE=auto
COMMAND_REGISTRATION_MODE=guild
PERIODIC_GUILD_COMMAND_SYNC_MS=1800000
# The sync only writes into servers whose command list changed (#215). 1 writes
# every server again once, e.g. after commands were deleted by hand.
GUILD_COMMAND_SYNC_FORCE=0
CLEAN_GLOBAL_COMMANDS_ON_BOOT=1
CLEAN_GUILD_COMMANDS_ON_BOOT=0
CLEAN_WORKER_GUILD_COMMANDS_ON_BOOT=1

# Web / API
WEB_PORT=8081
WEB_INTERNAL_PORT=8080
PUBLIC_WEB_URL=http://localhost:8081
WEB_DOMAIN=
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
CHECKOUT_RETURN_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
API_ADMIN_TOKEN=change-me
# Set to 1 only when every request reaches OmniFM through one of the exact
# addresses in TRUSTED_PROXY_IPS. Keep this at 0 when WEB_PORT is public.
TRUST_PROXY_HEADERS=0
# Example for a local reverse proxy: 127.0.0.1,::1
TRUSTED_PROXY_IPS=

# Language
DEFAULT_LANGUAGE=en

# Dashboard OAuth
DISCORD_CLIENT_ID=your_dashboard_client_id
DISCORD_CLIENT_SECRET=your_dashboard_client_secret
DISCORD_REDIRECT_URI=http://localhost:8081/api/auth/discord/callback
DISCORD_OAUTH_SCOPES=identify guilds
DASHBOARD_SESSION_COOKIE=omnifm_session
DASHBOARD_SESSION_TTL_SECONDS=86400
DISCORD_OAUTH_STATE_TTL_SECONDS=600

# Premium / billing / email
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PRO_TRIAL_ENABLED=1
EXPIRY_REMINDER_DAYS=30,14,7,1
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
ADMIN_EMAIL=
# SMTP uses STARTTLS by default (SMTPS on port 465) and verifies certificates.
# Set SMTP_TLS_MODE=plain only for a deliberately unencrypted legacy server.
SMTP_TLS_MODE=auto
# Keep this at 1. Set 0 only for a temporary, explicitly accepted legacy exception.
SMTP_TLS_REJECT_UNAUTHORIZED=1
# For private CAs, prefer SMTP_TLS_CA_PATH over disabling certificate validation.
SMTP_TLS_CA_PATH=
# Optional SNI/certificate hostname when it differs from SMTP_HOST.
SMTP_TLS_SERVERNAME=

# MongoDB / storage / logs
# Split mode requires MongoDB. Monolith mode can use file-backed fallback stores.
# For split Docker deployments keep MONGO_URL=mongodb://mongodb:27017 or MONGO_ENABLED=1.
MONGO_ENABLED=0
MONGO_URL=
DB_NAME=radio_bot
LOGS_DIR=runtime-data/logs
LOG_MAX_MB=5
LOG_MAX_FILES=30
LOG_MAX_DAYS=14
BOT_STATE_SPLIT_DIR=runtime-data/bot-state

# Playback / metadata
NOW_PLAYING_ENABLED=1
NOW_PLAYING_COVER_ENABLED=1
SONG_HISTORY_ENABLED=1
SONG_HISTORY_MAX_PER_GUILD=50
# Server auf demselben Sender teilen sich eine Metadaten-Abfrage pro Zeitfenster.
NOW_PLAYING_SNAPSHOT_CACHE_MS=36000
NOW_PLAYING_SNAPSHOT_ERROR_CACHE_MS=10000

# Audio recognition
NOW_PLAYING_RECOGNITION_ENABLED=0
ACOUSTID_API_KEY=
NOW_PLAYING_MUSICBRAINZ_ENABLED=1
NOW_PLAYING_RECOGNITION_SAMPLE_SECONDS=18
NOW_PLAYING_RECOGNITION_MIN_SECONDS=10
NOW_PLAYING_RECOGNITION_TIMEOUT_MS=28000
NOW_PLAYING_RECOGNITION_CAPTURE_RETRIES=2
NOW_PLAYING_RECOGNITION_CAPTURE_SAMPLE_RATE=44100
NOW_PLAYING_RECOGNITION_CAPTURE_CHANNELS=2
NOW_PLAYING_RECOGNITION_SCORE_THRESHOLD=0.55

# Voice / reliability
PREMIUM_GUILD_ACCESS_MODE=restrict
VOICE_CHANNEL_STATUS_ENABLED=1
VOICE_CHANNEL_STATUS_TEMPLATE=🔊 | 24/7 {station}
VOICE_CHANNEL_STATUS_REFRESH_MS=900000
VOICE_STATE_RECONCILE_ENABLED=1
VOICE_STATE_RECONCILE_MS=30000
VOICE_MOVE_POLICY=return
VOICE_MOVE_CONFIRMATIONS=2
VOICE_MOVE_RETURN_COOLDOWN_MS=15000
VOICE_MOVE_WINDOW_MS=120000
VOICE_MOVE_MAX_EVENTS_PER_WINDOW=4
VOICE_MOVE_ESCALATION=disconnect
VOICE_MOVE_ESCALATION_COOLDOWN_MS=600000
VOICE_TRANSIENT_RECHECK_MS=5000
VOICE_STATE_MISSING_CONFIRMATIONS=2
VOICE_RECONNECT_RESOURCE_CONFIRMATIONS=3
VOICE_RECONNECT_CIRCUIT_BREAKER_ATTEMPTS=30
VOICE_RECONNECT_CIRCUIT_BREAKER_MS=900000
VOICE_RECONNECT_MAX_MS=120000
# Ein geparktes Wiedergabeziel (Rechte fehlen, Voice laenger nicht erreichbar) wird in diesem Takt weiter probiert.
VOICE_PARKED_RETRY_MS=900000
STREAM_RESTART_BASE_MS=1000
STREAM_RESTART_MAX_MS=120000
STREAM_STABLE_RESET_MS=60000
STREAM_ERROR_COOLDOWN_THRESHOLD=8
STREAM_ERROR_COOLDOWN_MS=60000
# Automatischer Senderwechsel ist nur mit einer expliziten Guild-Failover-Kette erlaubt.
# Vorher muss die aktive Quelle mehrfach und laenger anhaltend fehlschlagen.
STREAM_FAILOVER_MIN_FAILURES=3
STREAM_FAILOVER_MIN_UNSTABLE_MS=60000
# Liefert ein Sender so lange am Stueck Audio, startet der Failover-Zaehler neu.
# Ein Failover braucht ausserdem so lange KEIN Audio wie STREAM_FAILOVER_MIN_UNSTABLE_MS.
STREAM_FAILOVER_STABLE_AUDIO_MS=25000
# Failback: waehrend eines Failovers wird der Wunschsender regelmaessig geprueft und
# nach STREAM_FAILBACK_CONFIRMATIONS erfolgreichen Pruefungen automatisch wiederhergestellt.
STREAM_FAILBACK_ENABLED=1
STREAM_FAILBACK_CHECK_MS=120000
STREAM_FAILBACK_MAX_MS=900000
STREAM_FAILBACK_CONFIRMATIONS=2
STREAM_FAILBACK_PROBE_TIMEOUT_MS=5000
DNS_LOOKUP_RETRY_COUNT=3
DNS_LOOKUP_RETRY_DELAY_MS=750
DNS_LOOKUP_CACHE_TTL_MS=600000
DNS_LOOKUP_STALE_TTL_MS=3600000

# Split runtime / remote workers
REMOTE_WORKER_HEARTBEAT_MS=5000
REMOTE_WORKER_COMMAND_POLL_MS=1000
# With the split supervisor a new command rings the worker at once over IPC;
# the worker then only polls every REMOTE_WORKER_COMMAND_FALLBACK_POLL_MS.
REMOTE_WORKER_COMMAND_FALLBACK_POLL_MS=5000
REMOTE_WORKER_COMMAND_TTL_MS=300000
REMOTE_WORKER_STATUS_POLL_MS=2000
REMOTE_WORKER_STATUS_STALE_MS=45000
UPDATE_STRATEGY=rolling
UPDATE_ROLLING_DELAY_MS=15000
UPDATE_ROLLING_WAIT_TIMEOUT_MS=120000
WORKER_AUTOHEAL_ENABLED=1
WORKER_AUTOHEAL_CHECK_MS=30000
WORKER_AUTOHEAL_GRACE_MS=600000
WORKER_AUTOHEAL_RECOVERING_MS=1200000
# Nach einem Autoheal-Neustart wartet das betroffene Ziel genau diese Pause, ohne Verdopplung.
WORKER_AUTOHEAL_BLOCK_MS=900000
WORKER_AUTOHEAL_BLOCK_MAX_MS=900000

# DiscordBotList / discordbotlist.com
DISCORDBOTLIST_ENABLED=0
DISCORDBOTLIST_TOKEN=
DISCORDBOTLIST_BOT_ID=
DISCORDBOTLIST_SLUG=
DISCORDBOTLIST_WEBHOOK_SECRET=
DISCORDBOTLIST_STATS_SCOPE=aggregate
DISCORDBOTLIST_COMMANDS_SYNC_MS=21600000
DISCORDBOTLIST_STATS_SYNC_MS=1800000
DISCORDBOTLIST_VOTE_SYNC_MS=1800000

# discord.bots.gg
BOTSGG_ENABLED=0
BOTSGG_TOKEN=
BOTSGG_BOT_ID=
BOTSGG_STATS_SCOPE=aggregate
BOTSGG_STARTUP_DELAY_MS=15000
BOTSGG_STATS_SYNC_MS=1800000

# Top.gg
TOPGG_ENABLED=0
TOPGG_TOKEN=
TOPGG_BOT_ID=
TOPGG_WEBHOOK_SECRET=
TOPGG_STATS_SCOPE=aggregate
TOPGG_STARTUP_DELAY_MS=15000
TOPGG_PROJECT_SYNC_MS=21600000
TOPGG_COMMANDS_SYNC_MS=21600000
TOPGG_STATS_SYNC_MS=1800000
TOPGG_VOTE_SYNC_MS=1800000
TOPGG_VOTE_SYNC_START_DAYS=30

# Legal pages
# Product and legal operator are intentionally separate.
# Replace all Example/localhost values before using the public legal pages in production.
LEGAL_PRODUCT_NAME=OmniFM
LEGAL_PROVIDER_NAME=IT-Tabelander
LEGAL_LEGAL_FORM=Kleinunternehmen
LEGAL_STREET_ADDRESS=Example Street 1
LEGAL_POSTAL_CODE=1010
LEGAL_CITY=Vienna
LEGAL_COUNTRY=Austria
LEGAL_EMAIL=legal@example.com
LEGAL_WEBSITE=http://localhost:8081

PRIVACY_CONTACT_EMAIL=privacy@example.com
PRIVACY_HOSTING_PROVIDER=Example Hosting
PRIVACY_HOSTING_LOCATION=EU / Austria

TERMS_CONTACT_EMAIL=terms@example.com
TERMS_SUPPORT_URL=http://localhost:8081/terms
TERMS_EFFECTIVE_DATE=2026-04-13
TERMS_GOVERNING_LAW=Law of the Republic of Austria
TERMS_CUSTOM_NOTE=

# =============================================================================
# Erweiterte Betriebsschalter
#
# Alle Werte unten sind die Standardwerte des Codes. Auf dem Server gehoeren
# Aenderungen in backend/.env: die systemd-Units und der Bot-Start lesen diese
# Datei. Werte aus dem Owner-Menue (System-Konfiguration) haben Vorrang.
# Auskommentierte Zeilen (# NAME=) sind optionale Overrides: nur setzen, wenn
# der beschriebene Effekt gewuenscht ist, sonst gilt die Automatik.
# =============================================================================

# ---- Web / API --------------------------------------------------------------
WEB_BIND=0.0.0.0
# Node-Webserver im Bot-Prozess. Produktion nutzt FastAPI (:8001); der
# Bot-Start setzt den Wert selbst auf 0.
# WEB_SERVER_ENABLED=0
WEB_STRICT_FRONTEND_BUILD=0
WEB_ALLOW_LEGACY_FALLBACK=0
API_RATE_STATE_MAX_ENTRIES=50000
# FastAPI: Anfragen pro Zeitfenster und Client (lesen / schreiben).
API_RATE_READ_MAX=120
API_RATE_READ_WINDOW_MS=60000
API_RATE_WRITE_MAX=20
API_RATE_WRITE_WINDOW_MS=60000
# HSTS: ohne Angabe automatisch aktiv, sobald die oeffentliche URL https ist.
# SECURITY_HSTS_ENABLED=1
# SECURITY_HSTS_PRELOAD=0
# Nur Entwicklung: FastAPI legt Demo-Daten an.
SEED_DEMO_DATA=0

# ---- Betreiber-Alarme, Metriken, Health-Report --------------------------------
# Discord-Webhook fuer Start, Absturz und Login-Fehler der Bots.
OPERATOR_WEBHOOK_URL=
# Standard: aktiv, sobald eine URL gesetzt ist. 0 schaltet trotz URL ab.
# OPERATOR_WEBHOOK_ENABLED=1
# Optional: User oder Rolle pingen, z. B. <@123456789012345678>
OPERATOR_WEBHOOK_MENTION=
OPERATOR_INCIDENT_REPEAT_COOLDOWN_MS=300000
# Prometheus-Endpunkt /metrics im Node-Webserver.
METRICS_ENABLED=0
METRICS_TOKEN=
# Wie oft der Bot seine Live-Metriken nach MongoDB (runtime_health) schreibt.
RUNTIME_HEALTH_INTERVAL_MS=5000

# ---- Logs ---------------------------------------------------------------------
LOG_ROTATE_CHECK_MS=5000
LOG_PRUNE_CHECK_MS=600000
LOG_REPEAT_COOLDOWN_MS=300000
# warn = nur Fehler/Warnungen von ffmpeg, all = alles, off = nichts
FFMPEG_STDERR_VERBOSITY=warn

# ---- Audio / Transcoding --------------------------------------------------------
# Transcoding laeuft automatisch, sobald ein Plan eine Bitrate vorgibt
# (Free 64k, Pro 128k, Ultimate 320k) oder ein Qualitaets-Preset gesetzt ist.
TRANSCODE=0
TRANSCODE_MODE=opus
OPUS_BITRATE=192k
OPUS_VBR=on
OPUS_COMPRESSION=5
OPUS_FRAME=20
# Automatisch: "audio" bzw. 8 % fuer Ultimate/hohe Bitrate, sonst "lowdelay" bzw. 3 %.
# OPUS_APPLICATION=lowdelay
# OPUS_PACKET_LOSS=3
# ffmpeg-Puffer. Automatisch je Profil (stabil / ultra-stabil):
# Queue 2048/4096, Probe 131072/262144, Analyse 2000000/3000000 us,
# Puffer 64M/96M, max. Verzoegerung 400000/600000 us.
# FFMPEG_THREAD_QUEUE_SIZE=2048
# FFMPEG_PROBESIZE=131072
# FFMPEG_ANALYZE_US=2000000
# FFMPEG_RTBUFSIZE=64M
# FFMPEG_MAX_DELAY_US=400000
FFMPEG_RW_TIMEOUT_US=20000000
FFMPEG_IO_TIMEOUT_US=20000000
FFMPEG_OUTPUT_FLUSH_PACKETS=0

# ---- Stream-Healthcheck und Neustarts ------------------------------------------
# Kommen laenger als STALL_MS keine Audiodaten (ausser bei Pause), wird der
# Stream neu gestartet.
STREAM_HEALTHCHECK_ENABLED=1
STREAM_HEALTHCHECK_POLL_MS=15000
STREAM_HEALTHCHECK_GRACE_MS=30000
STREAM_HEALTHCHECK_STALL_MS=45000
STREAM_HEALTHCHECK_RESTART_MS=1250
# Sender, die immer wieder regulaer enden (EOF), bekommen wachsende Pausen.
STREAM_IDLE_RESTART_WINDOW_MS=900000
STREAM_IDLE_RESTART_EXP_STEPS=6

# ---- Voice / Reconnect (Ergaenzung) ---------------------------------------------
VOICE_CHANNEL_STATUS_MAX_LENGTH=80
VOICE_RECONNECT_PERMISSION_CONFIRMATIONS=6
VOICE_RECONNECT_READY_FAILURE_CONFIRMATIONS=4
VOICE_RECONNECT_MAX_CIRCUIT_TRIPS=3
RESTORE_RETRY_BASE_MS=15000
RESTORE_RETRY_MAX_MS=300000

# ---- Sender-Pruefung (Owner-Menue: System -> Sender-Health) ------------------------
STATION_HEALTH_ENABLED=1
STATION_HEALTH_INTERVAL_MS=5000
STATION_HEALTH_BATCH_SIZE=2
STATION_HEALTH_CONCURRENCY=2
STATION_HEALTH_TIMEOUT_MS=8000

# ---- Laufzeit ------------------------------------------------------------------
LISTENER_STATS_POLL_MS=30000
ONBOARDING_MESSAGE_ENABLED=1
PREMIUM_STORE_REFRESH_MS=2000
EVENT_SCHEDULER_ENABLED=1
# Standard: Zeitzone des Servers.
# EVENT_DEFAULT_TIMEZONE=Europe/Vienna

# ---- Slash-Command-Sync (nur bei COMMAND_REGISTRATION_MODE=guild) ------------------
# Standard: nach dem Start zufaellig 5-10 s warten, nach einem Server-Beitritt
# 10-20 s; 3 Versuche (2 beim Beitritt) im Abstand von 10 s; Timeout 15 s
# (30 s beim Beitritt). Feste Werte nur bei Rate-Limit-Problemen setzen.
# GUILD_COMMAND_SYNC_READY_DELAY_MS=7000
# GUILD_COMMAND_SYNC_READY_DELAY_MIN_MS=5000
# GUILD_COMMAND_SYNC_READY_DELAY_MAX_MS=10000
# GUILD_COMMAND_SYNC_JOIN_DELAY_MS=12000
# GUILD_COMMAND_SYNC_JOIN_DELAY_MIN_MS=10000
# GUILD_COMMAND_SYNC_JOIN_DELAY_MAX_MS=20000
# GUILD_COMMAND_SYNC_JOIN_TRANSPORT=fetch
# GUILD_COMMAND_SYNC_TRIES=3
# GUILD_COMMAND_SYNC_JOIN_TRIES=2
# GUILD_COMMAND_SYNC_RETRY_DELAY_MS=10000
# GUILD_COMMAND_SYNC_REQUEST_TIMEOUT_MS=15000
# GUILD_COMMAND_SYNC_JOIN_REQUEST_TIMEOUT_MS=30000
# Aeltere Namen derselben Schalter:
# GUILD_COMMAND_READY_DELAY_MS=
# GUILD_COMMAND_SYNC_STARTUP_DELAY_MIN_MS=
# GUILD_COMMAND_SYNC_STARTUP_DELAY_MAX_MS=
# GUILD_COMMAND_SYNC_RETRIES=
# GUILD_COMMAND_SYNC_RETRY_MS=

# ---- Speicherorte (Standard: das Repo-Verzeichnis, Umzug nach runtime-data/ in #227) ----
# OMNIFM_RUNTIME_DATA_DIR=runtime-data
# OMNIFM_BOT_STATE_FILE=
# OMNIFM_CUSTOM_STATIONS_FILE=
# OMNIFM_COMMAND_PERMISSIONS_FILE=
# OMNIFM_DASHBOARD_FILE=
# OMNIFM_OWNER_AUDIT_FILE=
# OMNIFM_OWNER_LOGS_DIR=
# OMNIFM_ENV_FILE=

# ---- Datenschutzerklaerung: Overrides (Standard: Werte aus LEGAL_* bzw. Owner-Menue) --
# PRIVACY_CONTROLLER_NAME=
# PRIVACY_CONTROLLER_REPRESENTATIVE=
# PRIVACY_CONTROLLER_STREET_ADDRESS=
# PRIVACY_CONTROLLER_POSTAL_CODE=
# PRIVACY_CONTROLLER_CITY=
# PRIVACY_CONTROLLER_COUNTRY=
# PRIVACY_CONTROLLER_WEBSITE=
# PRIVACY_CONTACT_PHONE=
# PRIVACY_DPO_NAME=
# PRIVACY_DPO_EMAIL=
# PRIVACY_AUTHORITY_NAME=
# PRIVACY_AUTHORITY_WEBSITE=
# PRIVACY_ADDITIONAL_RECIPIENTS=
# PRIVACY_CUSTOM_NOTE=

# ---- Werkzeuge (Release-Gate, Live-Smoke, Erkennungs-Diagnose) ------------------------
# OMNIFM_BASE_URL=https://omnifm.xyz
# OMNIFM_LIVE_ADMIN_TOKEN=
# OMNIFM_LOG_DIR=./logs
# RECOGNITION_TEST_URL=

# ---- Aeltere Namen, weiterhin gelesen (neue Installationen nutzen den rechten Namen) ----
# ADMIN_API_TOKEN=          -> API_ADMIN_TOKEN
# ADMIN_TOKEN=              -> API_ADMIN_TOKEN
# OMNIFM_ADMIN_TOKEN=       -> API_ADMIN_TOKEN
# CORS_ORIGINS=             -> CORS_ALLOWED_ORIGINS
# STRIPE_API_KEY=           -> STRIPE_SECRET_KEY
# DEFAULT_LANG=             -> DEFAULT_LANGUAGE
# APP_LANGUAGE=             -> DEFAULT_LANGUAGE
# HSTS_ENABLED=             -> SECURITY_HSTS_ENABLED
# DISCORD_BOT_TOKEN=        -> Commander-Token im Owner-Menue
# Nur Anzeige in der alten Node-Owner-Uebersicht:
# BOT_COUNT=
# BOT_MODE=
# RUNTIME_ROLE=
# OMNIFM_PROCESS_MODE=

# --- Dashboard-Backend (#195) ------------------------------------------------
# node: FastAPI (:8001) leitet /api/auth und /api/dashboard intern an die
# Node-API im Commander weiter; diese lauscht nur auf 127.0.0.1. start.sh
# trägt "node" in backend/.env ein. fastapi: die alten FastAPI-Routen
# antworten (Rückweg, falls etwas klemmt).
OMNIFM_DASHBOARD_BACKEND=fastapi
# Port der Node-API auf 127.0.0.1 (beide Seiten lesen ihn).
OMNIFM_NODE_API_PORT=8002
# Nur falls die Node-API woanders läuft: vollständige Adresse für FastAPI.
# OMNIFM_NODE_API_URL=http://127.0.0.1:8002
