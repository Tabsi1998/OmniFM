# OmniFM API (Node, #290): the public entry on the backend port. It answers the
# website, the owner console, premium and the webhooks, and passes dashboard,
# Discord login, share cards and cockpit to the commander's Node API on
# 127.0.0.1 (omnifm-bot). OMNIFM_PUBLIC_BACKEND=fastapi in backend/.env renders
# omnifm-backend-fastapi.service here instead (the way back).
# Rendered by start.sh: the double-underscore markers (ROOT, USER, ports, node
# path) are replaced with the values of this installation before the unit is
# written to /etc/systemd/system. Do not edit the rendered copy, edit this template.
[Unit]
Description=OmniFM API (Node on port __BACKEND_PORT__)
Documentation=https://github.com/Tabsi1998/OmniFM#readme
After=network-online.target mongod.service
Wants=network-online.target mongod.service

[Service]
Type=simple
User=__USER__
WorkingDirectory=__ROOT__
EnvironmentFile=-__ROOT__/backend/.env
Environment=PATH=__NODE_DIR__:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# Runtime files live in runtime-data/ (part of the update backup), logs in
# logs/, never between the code in the repository root (#227).
Environment=OMNIFM_RUNTIME_DATA_DIR=__ROOT__/runtime-data
Environment=LOGS_DIR=__ROOT__/logs
Environment=NODE_ENV=production
# Port and address on the command line: the EnvironmentFile would win over Environment=.
ExecStart=__NODE__ src/entrypoints/api.js --port __BACKEND_PORT__ --host 0.0.0.0
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=30
StandardOutput=append:__ROOT__/logs/backend.log
StandardError=append:__ROOT__/logs/backend.log

[Install]
WantedBy=multi-user.target
