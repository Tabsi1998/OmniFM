# OmniFM Discord runtime: the bootstrap reads commander and workers from the
# owner console (MongoDB) and supervises them as child processes. Rendered by
# start.sh, see omnifm-backend.service for the placeholder rules.
[Unit]
Description=OmniFM Discord runtime (commander + workers)
Documentation=https://github.com/Tabsi1998/OmniFM#readme
After=network-online.target mongod.service omnifm-backend.service
Wants=network-online.target mongod.service

[Service]
Type=simple
User=__USER__
WorkingDirectory=__ROOT__
# backend/.env carries MONGO_URL and DB_NAME and is the one place for runtime
# tuning (VOICE_*, STREAM_*, LOG_*) on a server, see .env.example.
EnvironmentFile=-__ROOT__/backend/.env
Environment=PATH=__NODE_DIR__:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# Runtime files live in runtime-data/ (part of the update backup), logs in
# logs/, never between the code in the repository root (#227).
Environment=OMNIFM_RUNTIME_DATA_DIR=__ROOT__/runtime-data
Environment=LOGS_DIR=__ROOT__/logs
Environment=NODE_ENV=production
ExecStart=__NODE__ src/entrypoints/from-owner-config.mjs
Restart=always
RestartSec=5
# 78 (EX_CONFIG): no commander token in the owner console yet. That is a
# configuration state, not a crash, so systemd must not restart-loop on it.
RestartPreventExitStatus=78
SuccessExitStatus=78
KillSignal=SIGTERM
TimeoutStopSec=45
# The runtime writes its own logs/bot.log; this file catches the bootstrap and
# crash output that happens before the logger exists.
StandardOutput=append:__ROOT__/logs/bot-console.log
StandardError=append:__ROOT__/logs/bot-console.log

[Install]
WantedBy=multi-user.target
