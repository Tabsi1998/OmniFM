[Unit]
Description=OmniFM (Docker)
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=__APP_DIR__
# The wrapper reconciles profile-disabled workers and stops an old commander
# before a changed split topology can create a duplicate Discord identity.
# systemd starts as root, but runtime-data must keep the Compose default owner.
Environment=OMNIFM_CONTAINER_UID=1000
Environment=OMNIFM_CONTAINER_GID=1000
ExecStart=/usr/bin/bash "__APP_DIR__/scripts/compose.sh" up -d --build
ExecStop=/usr/bin/bash "__APP_DIR__/scripts/compose.sh" down --remove-orphans
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
